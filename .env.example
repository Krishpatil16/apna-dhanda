# Apna Dhanda — configuration (placeholders only; never commit real values)
# Real secrets live ONLY in Cloudflare Worker secrets (see below). These are local-dev / test values.

# Local development only (dev-server.mjs turns these into the same hashed formats the Worker reads from env)
KIRANA_SETUP_KEY=change-me-to-a-long-random-string
KIRANA_DEV_PASS=change-me-local-dev-password
KIRANA_DEV_RECOVERY=change-me-local-recovery-key
# Local SQLite file used by dev-server.mjs
KIRANA_DB=./local.sqlite

# End-to-end browser test
BASE=http://localhost:8787
ADMIN_USER=bhaiya
ADMIN_PASS=change-me
SETUP_KEY=change-me-to-a-long-random-string
CHROME=/path/to/chromium

# Production (set in the hosting platform, not here):
#   D1 database binding name: DB
#   Worker secrets (npx wrangler secret put NAME --config wrangler.apnadhanda.toml), made by `node tools/make-secrets.mjs`:
#     SETUP_KEY_HASH, DEV_RECOVERY_HASH  = pbkdf2-sha256$100000$<salt>$<hash>
#     DEV_SEED                           = krish-dev$<salt>$<hash>   (only used on an empty database)

# Deploying: authenticate with `npx wrangler login` (interactive). For CI only, wrangler reads
# CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID from the environment — never put them in a file in this repo.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
