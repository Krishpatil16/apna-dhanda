# Apna Dhanda — configuration (placeholders only; never commit real values)
# The worker has no runtime secrets. These are deploy-time / local-dev values.

# Local development only: setup key accepted by dev-server.mjs (the deployed worker uses the hash in _worker.mjs)
KIRANA_SETUP_KEY=change-me-to-a-long-random-string
# Local SQLite file used by dev-server.mjs
KIRANA_DB=./local.sqlite

# End-to-end browser test
BASE=http://localhost:8787
ADMIN_USER=bhaiya
ADMIN_PASS=change-me
SETUP_KEY=change-me-to-a-long-random-string
CHROME=/path/to/chromium

# Production (set in the hosting platform, not here):
#   D1 database binding name: DB
#   SETUP_KEY_SHA256 constant in site/_worker.mjs = sha256("kirana-setup:" + <your setup key>)

# Deploying: authenticate with `npx wrangler login` (interactive). For CI only, wrangler reads
# CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID from the environment — never put them in a file in this repo.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
